# ==============================================================================
# OpenShip Worker VPS — Initial Setup & Tuning Configuration
# ==============================================================================

# System Hostname (leave empty to keep current system hostname)
HOSTNAME=

# System Timezone (e.g. UTC, Europe/Warsaw, America/New_York)
TIMEZONE=UTC

# SSH Port (default: 22)
SSH_PORT=22

# Optional non-root administrator username (leave empty to skip user creation)
ADMIN_USER=

# Automatic swap configuration (true/false)
ENABLE_SWAP=true

# Swap size in GB (leave empty for auto: 2GB on <=2GB RAM, 4GB on >=4GB RAM)
SWAP_SIZE_GB=

# BBR Congestion Control (true/false)
ENABLE_BBR=true

# UFW Firewall (true/false)
# Automatically allows SSH_PORT, 80/tcp (HTTP), 443/tcp (HTTPS)
# Keeps database ports (3306, 6379) isolated
ENABLE_UFW=true

# Fail2ban protection for SSH (true/false)
ENABLE_FAIL2BAN=true

# Automatic security updates (true/false)
ENABLE_UNATTENDED_UPGRADES=true
