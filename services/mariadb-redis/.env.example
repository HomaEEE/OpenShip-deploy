# ==============================================================================
# OpenShip Worker Services — MariaDB + Redis Configuration
# ==============================================================================
# You can define these variables in OpenShip UI/CLI application settings
# or in a local .env file on the worker server.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server Characteristics (OPTIONAL — fully auto-detected by default)
# ------------------------------------------------------------------------------
# RAM and CPU cores are automatically detected from the host (/proc/meminfo and nproc).
# You do NOT need to set these. Uncomment ONLY to artificially limit resources.
# SERVER_RAM_GB=4
# SERVER_CPU_CORES=2

# ------------------------------------------------------------------------------
# MariaDB Configuration
# ------------------------------------------------------------------------------

# MariaDB Docker image tag (LTS versions: 11.4, 10.11)
MARIADB_VERSION=11.4

# MariaDB root password (MANDATORY: set via OpenShip or deploy.sh)
MARIADB_ROOT_PASSWORD=

# Published port for MariaDB on the host
MARIADB_PORT=3306

# InnoDB buffer pool size (optional manual override, e.g. 512M, 1G; defaults to 40% of RAM)
# MARIADB_BUFFER_POOL_SIZE=1G

# Max client connections (optional manual override; defaults to 30 + RAM_MB/50)
# MARIADB_MAX_CONNECTIONS=100

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------

# Redis Docker image tag
REDIS_VERSION=7.4-alpine

# Redis authentication password (strongly recommended for open ports)
REDIS_PASSWORD=

# Published port for Redis on the host
REDIS_PORT=6379

# Redis max memory limit (optional manual override, e.g. 256mb, 512mb; defaults to 15% of RAM)
# REDIS_MAXMEMORY=512mb

# Redis memory eviction policy (allkeys-lru, volatile-lru, noeviction)
REDIS_MAXMEMORY_POLICY=allkeys-lru

# ------------------------------------------------------------------------------
# Firewall / UFW Access Rules (Used by deploy.sh)
# ------------------------------------------------------------------------------

# Allowed client IP addresses or CIDR subnets for ports 3306 and 6379.
# Examples:
#   UFW_ALLOW_IPS="10.0.0.15"                         (single IP)
#   UFW_ALLOW_IPS="10.0.0.10, 10.0.0.11, 192.168.1.0/24" (multiple IPs / subnets)
#   UFW_ALLOW_IPS="any"                               (allow from any IP address)
# If left empty, deploy.sh will ask interactively during deployment.
UFW_ALLOW_IPS=
