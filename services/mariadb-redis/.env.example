# ==============================================================================
# OpenShip Shared Services — MariaDB + Redis Configuration
# ==============================================================================

# MariaDB Docker image tag (LTS: 11.4)
MARIADB_VERSION=11.4

# MariaDB root password (auto-generated by deploy.sh if not provided)
MARIADB_ROOT_PASSWORD=

# Redis Docker image tag
REDIS_VERSION=7.4-alpine

# Redis auth password (auto-generated by deploy.sh if not provided)
REDIS_PASSWORD=
