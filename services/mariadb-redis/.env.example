# ==============================================================================
# OpenShip Shared Services — MariaDB + Redis + phpMyAdmin Configuration
# ==============================================================================

# MariaDB Docker image tag (LTS: 11.4)
MARIADB_VERSION=11.4

# MariaDB root password (default: openship_root_secret if omitted)
MARIADB_ROOT_PASSWORD=openship_root_secret

# InnoDB Buffer Pool Size (default: 256M, for 2GB VPS recommend 128M - 256M)
MARIADB_BUFFER_POOL_SIZE=256M

# InnoDB Redo Log Size (default: 128M)
MARIADB_LOG_FILE_SIZE=128M

# Maximum concurrent connections
MARIADB_MAX_CONNECTIONS=150

# Slow query log (1 = enabled, 0 = disabled)
MARIADB_SLOW_QUERY_LOG=1
MARIADB_LONG_QUERY_TIME=2

# Container memory limits
MARIADB_MEMORY_LIMIT=1024M
REDIS_MEMORY_LIMIT=512M

# Redis Docker image tag
REDIS_VERSION=7.4-alpine

# Redis auth password (optional; empty = unauthenticated on private network)
REDIS_PASSWORD=

# phpMyAdmin Configuration
PHPMYADMIN_VERSION=latest
PHPMYADMIN_PORT=20003
PHPMYADMIN_BIND_IP=127.0.0.1
PHPMYADMIN_UPLOAD_LIMIT=512M
PHPMYADMIN_MEMORY_LIMIT=256M

# Docker network created by OpenShip (default: openship-openship-deploy)
OPENSHIP_NETWORK=openship-openship-deploy
