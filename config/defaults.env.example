# ==============================================================================
# OpenShip Deploy — Default Environment Configuration Examples
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Control Plane Configuration (Used by install.sh)
# ------------------------------------------------------------------------------
# State file is saved to /etc/openship-control/install.conf
#
# INSTALL_MODE=bare              # bare (lightweight Node process) or standard (Docker compose)
# OPENSHIP_ROLE=control          # Role: control (never runs production containers)
# OPENSHIP_HOST_CONTROL=false    # Harden: disables local host channel and deploy target
# HOSTNAME=openship-control      # Hostname of the control plane server
# TIMEZONE=UTC                   # Server timezone (e.g. UTC, Europe/Warsaw, Europe/Kyiv)
# SSH_PORT=22                    # SSH port
# ADMIN_USER=openship            # Administrator linux username
# ENABLE_UFW=true                # Enable UFW firewall (allow SSH, HTTP, HTTPS)
# ENABLE_FAIL2BAN=true           # Enable fail2ban for SSH
# ENABLE_SWAP=true               # Enable swapfile ('true' or 'false')
# SWAP_SIZE_GB=2                 # Swap size in GB (0 to disable)
#
# OPENSHIP_ADMIN_NAME=Admin      # OpenShip admin display name
# OPENSHIP_ADMIN_EMAIL=admin@example.com
# OPENSHIP_DOMAIN_KIND=custom    # 'custom' (public domain via Edge) or 'none' (local only)
# OPENSHIP_HOST=os.example.com   # Control plane public hostname
# OPENSHIP_PUBLIC_URL=https://os.example.com
# OPENSHIP_EDGE_ENABLED=true     # OpenShip Edge (:80/:443 via Docker) for control plane

# ------------------------------------------------------------------------------
# 2. Worker Services Configuration: MariaDB + Redis (Used by deploy-services.sh)
# ------------------------------------------------------------------------------
# Can be placed in services/mariadb-redis/.env or set via OpenShip App settings
#
# SERVER_RAM_GB=4
# SERVER_CPU_CORES=2
#
# MARIADB_VERSION=11.4
# MARIADB_ROOT_PASSWORD=your_secure_root_password_here
# MARIADB_PORT=3306
# MARIADB_BUFFER_POOL_SIZE=1G            # Optional (defaults to 40% of RAM)
# MARIADB_MAX_CONNECTIONS=100           # Optional (defaults to 30 + RAM_MB/50)
#
# REDIS_VERSION=7.4-alpine
# REDIS_PASSWORD=your_secure_redis_password_here
# REDIS_PORT=6379
# REDIS_MAXMEMORY=256mb
# REDIS_MAXMEMORY_POLICY=allkeys-lru
#
# UFW_ALLOW_IPS=10.0.0.5, 192.168.1.0/24  # Leave empty, specify IPs, or "any"
