# ==============================================================================
# OpenShip Deploy — Default Environment Configuration Examples
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Control Plane Configuration (Used by install.sh)
# ------------------------------------------------------------------------------
# State file is saved to /etc/openship-control/install.conf
#
# INSTALL_MODE=standard          # standard (Docker) or bare
# HOSTNAME=openship-control      # Hostname of the control plane server
# TIMEZONE=UTC                   # Server timezone (e.g. UTC, Europe/Warsaw, Europe/Kyiv)
# SSH_PORT=22                    # SSH port
# ADMIN_USER=deploy              # Administrator linux username
# ENABLE_UFW=true                # Enable UFW firewall (allow SSH, HTTP, HTTPS)
# ENABLE_FAIL2BAN=true           # Enable fail2ban for SSH
# ENABLE_SWAP=true               # Ensure 2 GB swapfile is configured

# ------------------------------------------------------------------------------
# 2. Worker Services Configuration: MariaDB + Redis (Used by deploy-services.sh)
# ------------------------------------------------------------------------------
# Can be placed in services/mariadb-redis/.env or set via OpenShip App settings
#
# MARIADB_VERSION=11.4
# MARIADB_ROOT_PASSWORD=your_secure_root_password_here
# MARIADB_PORT=3306
# MARIADB_BUFFER_POOL_SIZE=256M
#
# REDIS_VERSION=7.4-alpine
# REDIS_PASSWORD=your_secure_redis_password_here
# REDIS_PORT=6379
# REDIS_MAXMEMORY=256mb
# REDIS_MAXMEMORY_POLICY=allkeys-lru
#
# UFW_ALLOW_IPS=10.0.0.5, 192.168.1.0/24  # Leave empty, specify IPs, or "any"
